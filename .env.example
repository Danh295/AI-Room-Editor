# Copy to .env and fill in ONE of the providers below. The server reads this;
# it is never bundled into the client.
#
# --- Gemini (default) -------------------------------------------------------
# Free tier, no card required. Get a key at https://aistudio.google.com
#   -> "Get API key" -> "Create API key"
# Works with a personal Google account. School/Workspace accounts sometimes
# work too, but an admin can disable AI Studio for the domain -- if sign-in
# bounces you, use a personal account instead.
GEMINI_API_KEY=

# --- Anthropic (not implemented yet) ----------------------------------------
# The provider interface has a second implementation slot for Anthropic, but
# nothing fills it yet: setting this key logs a warning and the AI features
# stay unavailable. Use GEMINI_API_KEY.
# ANTHROPIC_API_KEY=

# Optional overrides
PORT=8787
