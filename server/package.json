{
  "name": "@room/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local API: Claude proxy, image cache, and project storage",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:express --external:cors --external:sharp --external:dotenv --external:@google/genai",
    "coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=html"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "sharp": "^0.35.5"
  }
}
