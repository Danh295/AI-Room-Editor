{
  "name": "ai-room-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local room and furniture planner with AI-assisted floor plan tracing and product ingestion",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run typecheck && npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "NODE_ENV=production npm run start --workspace server",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
